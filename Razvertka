                <div id="steps-tab" class="tab-content">
                    <h2 class="section-title">
                        <i class="fas fa-list-ol"></i> Пошаговое решение
                    </h2>
                    <div id="steps-container">
                        <!-- Шаги будут добавлены динамически -->
                    </div>
                </div>
            </main>
            
            <!-- Сайдбар -->
            <aside class="sidebar">
                <h3 style="margin-bottom: 20px; color: var(--primary-color);">
                    <i class="fas fa-info-circle"></i> Информация
                </h3>
                
                <!-- Бейджи предметов -->
                <div class="subject-badges" id="subject-badges">
                    <!-- Бейджи будут добавлены динамически -->
                </div>
                
                <!-- Статистика -->
                <div class="stats-box">
                    <h4 style="margin-bottom: 15px; color: var(--dark-color);">
                        <i class="fas fa-chart-bar"></i> Статистика ответа
                    </h4>
                    <div class="stat-item">
                        <span class="stat-label">Формул:</span>
                        <span class="stat-value" id="formula-count">0</span>

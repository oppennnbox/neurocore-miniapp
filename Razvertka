                    </div>
                    <div class="stat-item">
                        <span class="stat-label">Законов:</span>
                        <span class="stat-value" id="law-count">0</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">Символов:</span>
                        <span class="stat-value" id="char-count">0</span>
                    </div>
                </div>
                
                <!-- Действия -->
                <div style="margin-top: 25px;">
                    <button id="copy-link" class="tab" style="width: 100%; margin-bottom: 10px;">
                        <i class="fas fa-copy"></i> Копировать ссылку
                    </button>
                    <button id="print-btn" class="tab" style="width: 100%;">
                        <i class="fas fa-print"></i> Печать ответа
                    </button>

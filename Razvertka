        </div>
        
        <!-- Загрузка -->
        <div class="loading-container" id="loading">
            <div class="spinner"></div>
            <h2 style="margin-bottom: 10px; color: var(--primary-color);">Формируем ответ...</h2>
            <p style="color: var(--gray-color);">Это займет несколько секунд</p>
        </div>
        
        <!-- Ошибка -->
        <div class="error-container" id="error-container">
            <i class="fas fa-exclamation-triangle" style="font-size: 48px; color: var(--danger-color); margin-bottom: 20px;"></i>
            <h2 style="color: var(--danger-color); margin-bottom: 15px;">Ошибка загрузки</h2>
            <p id="error-message">Не удалось загрузить данные ответа</p>
            <button id="retry-btn" class="tab active" style="margin-top: 20px;">
                <i class="fas fa-redo"></i> Попробовать снова
            </button>
        </div>
        
        <!-- Футер -->
        <footer class="footer">
            <p>🤖 Развёрнутый ответ сгенерирован ботом <strong>Кор</strong></p>
            <p style="margin-top: 10px; font-size: 12px;">
                <i class="fas fa-bolt"></i> Оптимизировано для 20,000+ одновременных пользователей
            </p>
        </footer>

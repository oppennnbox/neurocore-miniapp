                    </div>
                </nav>
                
                <!-- Контент вкладок -->
                <div id="explanation-tab" class="tab-content active">
                    <h2 class="section-title">
                        <i class="fas fa-book-open"></i> Подробное объяснение
                    </h2>
                    <div class="answer-text" id="answer-content">
                        Загрузка...
                    </div>
                </div>
                
                <div id="formulas-tab" class="tab-content">
                    <h2 class="section-title">
                        <i class="fas fa-superscript"></i> Использованные формулы
                    </h2>
                    <div id="formulas-container" class="formula-grid">
                        <!-- Формулы будут добавлены динамически -->
                    </div>
                </div>
                
                <div id="laws-tab" class="tab-content">
                    <h2 class="section-title">
                        <i class="fas fa-balance-scale"></i> Соответствующие законы
                    </h2>

    <!-- Основной скрипт -->
    <script>
        // ============= ГЛОБАЛЬНЫЙ КОНТЕЙНЕР ДЛЯ МАСШТАБИРОВАНИЯ =============
        class AnswerEngine {
            constructor() {
                this.currentAnswer = null;
                this.userSession = this.generateSessionId();
                this.performanceStart = performance.now();
                this.config = this.getConfig();
                this.init();
            }
            
            // Генерация уникального ID сессии для каждого пользователя
            generateSessionId() {
                return 'user_' + Math.random().toString(36).substr(2, 9) + 
                       '_' + Date.now().toString(36);
            }
            
            // Конфигурация (кешируется в localStorage)
            getConfig() {
                const defaultConfig = {
                    scienceDetectors: {
                        math: /\b(интеграл|дифференциал|производная|уравнение|теорема|лемма|лимит|предел|матрица|вектор|функция|корень|степень|логарифм|синус|косинус|тангенс|тригонометрия|геометрия|алгебра)\b/i,
                        physics: /\b(закон|сила|ускорение|энергия|импульс|мощность|напряжение|ток|сопротивление|частота|волна|гравитация|механика|термодинамика)\b/i,
                        chemistry: /\b(моль|реакция|катализатор|окисление|восстановление|pH|концентрация|равновесие|элемент|молекула|атом)\b/i
                    },
                    laws: {
                        physics: {
                            "Первый закон Ньютона": "\\sum \\vec{F} = 0 \\Rightarrow \\vec{v} = \\text{const}",
                            "Второй закон Ньютона": "\\vec{F} = m\\vec{a}",
                            "Закон сохранения энергии": "E_{\\text{кин}} + E_{\\text{пот}} = \\text{const}",
                            "Закон Ома": "I = \\frac{U}{R}"
                        },
                        math: {
                            "Теорема Пифагора": "a^2 + b^2 = c^2",
                            "Формула производной": "\\frac{d}{dx}f(x) = \\lim_{h \\to 0} \\frac{f(x+h)-f(x)}{h}",
                            "Формула интеграла": "\\int f(x) dx = F(x) + C",
                            "Квадратное уравнение": "ax^2 + bx + c = 0"
                        },
                        chemistry: {
                            "Закон сохранения массы": "\\sum m_{\\text{исх}} = \\sum m_{\\text{пр}}",
                            "Уравнение состояния идеального газа": "PV = nRT",
                            "Закон действующих масс": "v = k[A]^m[B]^n"
                        }
                    },
                    maxFormulas: 15,
                    maxSteps: 20,
                    cacheEnabled: true,
                    cacheDuration: 300000 // 5 минут
                };
                
                try {
                    const saved = localStorage.getItem('answer_engine_config');
                    return saved ? JSON.parse(saved) : defaultConfig;
                } catch {
                    return defaultConfig;
                }
            }
            
            // Инициализация
            async init() {
                try {
                    this.setupEventListeners();
                    const answerData = await this.loadAnswerData();
                    
                    if (answerData) {
                        this.currentAnswer = answerData;
                        await this.renderAnswer(answerData);
                        this.showMainContent();
                        this.logPerformance();
                    } else {
                        this.showError('Не удалось загрузить данные ответа');
                    }
                } catch (error) {
                    console.error('Ошибка инициализации:', error);
                    this.showError('Ошибка при загрузке страницы');
                }
            }
            
            // Загрузка данных ответа
            async loadAnswerData() {
                // 1. Пробуем получить из URL параметров
                const urlData = this.parseUrlData();
                if (urlData) {
                    this.cacheAnswerData(urlData);
                    return urlData;
                }
                
                // 2. Пробуем получить из кэша
                if (this.config.cacheEnabled) {
                    const cachedData = this.getCachedAnswerData();
                    if (cachedData) return cachedData;
                }
                
                // 3. Пробуем получить из localStorage (fallback)
                const localStorageData = this.getLocalStorageData();
                if (localStorageData) return localStorageData;
                
                return null;
            }
            
            // Парсинг данных из URL (оптимизировано для массового использования)
            parseUrlData() {
                try {
                    const url = new URL(window.location.href);
                    
                    // Способ 1: Base64 encoded JSON (рекомендуется для бота)
                    const dataParam = url.searchParams.get('data');
                    if (dataParam) {
                        try {
                            const decoded = atob(dataParam);
                            return JSON.parse(decoded);
                        } catch {
                            // Если не JSON, пробуем как plain text
                            return {
                                text: decodeURIComponent(dataParam),
                                formulas: [],
                                question: '',
                                timestamp: Date.now()
                            };
                        }
                    }
                    
                    // Способ 2: Отдельные параметры (для совместимости)
                    const textParam = url.searchParams.get('text');
                    if (textParam) {
                        const data = {
                            text: decodeURIComponent(textParam),
                            formulas: url.searchParams.get('formulas') 
                                ? JSON.parse(decodeURIComponent(url.searchParams.get('formulas')))
                                : this.extractFormulas(decodeURIComponent(textParam)),
                            question: url.searchParams.get('question') 
                                ? decodeURIComponent(url.searchParams.get('question'))
                                : '',
                            timestamp: parseInt(url.searchParams.get('timestamp')) || Date.now()
                        };
                        return data;
                    }
                    
                    // Способ 3: Хэш в URL
                    const hash = url.hash.substring(1);
                    if (hash) {
                        try {
                            const decoded = atob(hash);
                            return JSON.parse(decoded);
                        } catch {
                            return null;
                        }
                    }
                    
                    return null;
                } catch (error) {
                    console.error('Ошибка парсинга URL:', error);
                    return null;
                }
            }
            
            // Кэширование данных ответа
            cacheAnswerData(data) {
                if (!this.config.cacheEnabled) return;
                
                try {
                    const cacheKey = `answer_cache_${this.userSession}`;
                    const cacheData = {
                        data: data,
                        timestamp: Date.now(),
                        session: this.userSession
                    };
                    
                    // Сохраняем в sessionStorage для текущей сессии
                    sessionStorage.setItem(cacheKey, JSON.stringify(cacheData));
                    
                    // Сохраняем в localStorage для быстрого доступа
                    const simplifiedData = {
                        text: data.text.substring(0, 1000), // Сохраняем только начало
                        formulas: data.formulas,
                        timestamp: data.timestamp
                    };
                    localStorage.setItem('last_answer', JSON.stringify(simplifiedData));
                } catch (error) {
                    console.warn('Не удалось закэшировать данные:', error);
                }
            }
            
            // Получение данных из кэша
            getCachedAnswerData() {
                try {
                    const cacheKey = `answer_cache_${this.userSession}`;
                    const cached = sessionStorage.getItem(cacheKey);
                    
                    if (cached) {
                        const cacheData = JSON.parse(cached);
                        const age = Date.now() - cacheData.timestamp;
                        
                        if (age < this.config.cacheDuration) {
                            return cacheData.data;
                        }
                    }
                } catch {
                    // Игнорируем ошибки кэша
                }
                return null;
            }
            
            // Получение данных из localStorage
            getLocalStorageData() {
                try {
                    const saved = localStorage.getItem('last_answer');
                    return saved ? JSON.parse(saved) : null;
                } catch {
                    return null;
                }
            }
            
            // Анализ предметов
            analyzeSubjects(text) {
                const subjects = new Set();
                
                for (const [subject, pattern] of Object.entries(this.config.scienceDetectors)) {
                    if (pattern.test(text)) {
                        subjects.add(subject);
                    }
                }
                
                // Если предметы не определены, определяем по контексту
                if (subjects.size === 0) {
                    if (text.includes('+') || text.includes('-') || text.includes('×') || text.includes('÷')) {
                        subjects.add('math');
                    }
                }
                
                return Array.from(subjects);
            }
            
            // Извлечение формул из текста
            extractFormulas(text) {
                const formulas = [];
                const patterns = [
                    /\$\$(.*?)\$\$/g,
                    /\\\[(.*?)\\\]/g,
                    /\\\((.*?)\\\)/g
                ];
                
                for (const pattern of patterns) {
                    let match;
                    while ((match = pattern.exec(text)) !== null) {
                        formulas.push(match[1].trim());
                    }
                }
                
                return formulas.slice(0, this.config.maxFormulas);
            }
            
            // Разбиение текста на шаги
            extractSteps(text) {
                const steps = [];
                
                // Ищем нумерованные шаги
                const stepPatterns = [
                    /(\d+)\.\s+(.*?)(?=\n\d+\.|\n\n|$)/gs,
                    /[•\-*]\s+(.*?)(?=\n[•\-*]|\n\n|$)/gs,
                    /Шаг\s+\d+[.:]\s+(.*?)(?=\nШаг\s+\d|$)/gis
                ];
                
                for (const pattern of stepPatterns) {
                    const matches = text.match(pattern);
                    if (matches && matches.length > 1) {
                        matches.forEach(match => steps.push(match));
                        break;
                    }
                }
                
                // Если шаги не найдены, разбиваем по абзацам
                if (steps.length === 0) {
                    const paragraphs = text.split('\n\n').filter(p => p.trim().length > 30);
                    steps.push(...paragraphs.slice(0, this.config.maxSteps));
                }
                
                return steps;
            }
            
            // Рендеринг ответа
            async renderAnswer(data) {
                // 1. Устанавливаем базовую информацию
                this.setBasicInfo(data);
                
                // 2. Определяем предметы
                const subjects = this.analyzeSubjects(data.text);
                this.renderSubjectBadges(subjects);
                
                // 3. Рендерим контент вкладок (асинхронно для производительности)
                await Promise.all([
                    this.renderExplanation(data.text),
                    this.renderFormulas(data.formulas),
                    this.renderLaws(subjects),
                    this.renderSteps(data.text)
                ]);
                
                // 4. Обновляем статистику
                this.updateStatistics(data, subjects);
                
                // 5. Показываем вкладки
                this.showTabs();
            }
            
            // Установка базовой информации
            setBasicInfo(data) {
                // Устанавливаем заголовок
                const title = document.getElementById('page-title');
                const subjects = this.analyzeSubjects(data.text);
                
                if (subjects.includes('math')) {
                    title.textContent = '📐 Математика • Развёрнутый ответ';
                } else if (subjects.includes('physics')) {
                    title.textContent = '⚛️ Физика • Развёрнутый ответ';
                } else if (subjects.includes('chemistry')) {
                    title.textContent = '🧪 Химия • Развёрнутый ответ';
                }
                
                // Показываем вопрос если есть
                if (data.question) {
                    const questionPreview = document.getElementById('question-preview');
                    questionPreview.textContent = `❓ ${data.question.substring(0, 150)}${data.question.length > 150 ? '...' : ''}`;
                    questionPreview.style.display = 'block';
                }
                
                // Устанавливаем ID пользователя
                document.getElementById('user-id').textContent = this.userSession.split('_')[1];
            }
            
            // Рендеринг бейджей предметов
            renderSubjectBadges(subjects) {
                const container = document.getElementById('subject-badges');
                container.innerHTML = '';
                
                const icons = {
                    math: '📐',
                    physics: '⚛️',
                    chemistry: '🧪'
                };
                
                const names = {
                    math: 'Математика',
                    physics: 'Физика',
                    chemistry: 'Химия'
                };
                
                subjects.forEach(subject => {
                    const badge = document.createElement('div');
                    badge.className = `subject-badge subject-${subject}`;
                    badge.innerHTML = `${icons[subject] || '📚'} ${names[subject] || subject}`;
                    container.appendChild(badge);
                });
                
                if (subjects.length === 0) {
                    const badge = document.createElement('div');
                    badge.className = 'subject-badge subject-math';
                    badge.innerHTML = '📚 Общий ответ';
                    container.appendChild(badge);
                }
            }
            
            // Рендеринг объяснения
            async renderExplanation(text) {
                const container = document.getElementById('answer-content');
                
                // Очищаем контейнер
                container.innerHTML = '';
                
                // Разбиваем текст на абзацы для лучшей производительности
                const paragraphs = text.split('\n\n').filter(p => p.trim());
                
                // Рендерим постепенно (чтобы не блокировать UI)
                for (let i = 0; i < paragraphs.length; i++) {
                    const paragraph = paragraphs[i];
                    const p = document.createElement('p');
                    p.style.marginBottom = '15px';
                    p.textContent = paragraph;
                    container.appendChild(p);
                    
                    // Делаем небольшую паузу между рендерингом абзацев
                    if (i % 3 === 0) {
                        await this.delay(0); // yield to main thread
                    }
                }
            }
            
            // Рендеринг формул
            async renderFormulas(formulas) {
                const container = document.getElementById('formulas-container');
                container.innerHTML = '';
                
                if (!formulas || formulas.length === 0) {
                    container.innerHTML = `
                        <div style="text-align: center; padding: 40px; color: #64748b; grid-column: 1 / -1;">
                            <i class="fas fa-calculator" style="font-size: 48px; opacity: 0.5;"></i>
                            <p style="margin-top: 15px;">Формулы не найдены</p>
                        </div>
                    `;
                    return;
                }
                
                // Рендерим формулы с отложенной загрузкой
                for (let i = 0; i < formulas.length; i++) {
                    const formulaCard = document.createElement('div');
                    formulaCard.className = 'formula-card';
                    
                    const header = document.createElement('div');
                    header.style.cssText = 'font-weight: 600; color: #475569; margin-bottom: 10px;';
                    header.textContent = `Формула ${i + 1}`;
                    
                    const katexDiv = document.createElement('div');
                    
                    try {
                        katex.render(formulas[i], katexDiv, {
                            throwOnError: false,
                            displayMode: true,
                            trust: true
                        });
                    } catch (error) {
                        katexDiv.innerHTML = `<div style="color: #ef4444; font-family: monospace;">${formulas[i]}</div>`;
                    }
                    
                    formulaCard.appendChild(header);
                    formulaCard.appendChild(katexDiv);
                    container.appendChild(formulaCard);
                    
                    // Делаем паузу между рендерингом сложных формул
                    if (formulas[i].length > 100) {
                        await this.delay(10);
                    }
                }
            }
            
            // Рендеринг законов
            async renderLaws(subjects) {
                const container = document.getElementById('laws-container');
                container.innerHTML = '';
                
                let hasLaws = false;
                
                for (const subject of subjects) {
                    const subjectLaws = this.config.laws[subject];
                    if (subjectLaws) {
                        hasLaws = true;
                        
                        const subjectHeader = document.createElement('h3');
                        subjectHeader.style.cssText = 'margin: 20px 0 15px 0; color: #1e293b; font-size: 18px;';
                        subjectHeader.textContent = subject === 'math' ? '📐 Математические теоремы' :
                                                  subject === 'physics' ? '⚛️ Физические законы' :
                                                  subject === 'chemistry' ? '🧪 Химические законы' : 'Законы';
                        
                        container.appendChild(subjectHeader);
                        
                        for (const [lawName, lawFormula] of Object.entries(subjectLaws)) {
                            const lawCard = document.createElement('div');
                            lawCard.className = 'formula-card';
                            lawCard.style.marginBottom = '15px';
                            
                            const nameDiv = document.createElement('div');
                            nameDiv.style.cssText = 'font-weight: 600; color: #7c3aed; margin-bottom: 10px;';
                            nameDiv.textContent = lawName;
                            
                            const katexDiv = document.createElement('div');
                            try {
                                katex.render(lawFormula, katexDiv, {
                                    throwOnError: false,
                                    displayMode: true
                                });
                            } catch {
                                katexDiv.textContent = lawFormula;
                            }
                            
                            lawCard.appendChild(nameDiv);
                            lawCard.appendChild(katexDiv);
                            container.appendChild(lawCard);
                        }
                    }
                }
                
                if (!hasLaws) {
                    container.innerHTML = `
                        <div style="text-align: center; padding: 40px; color: #64748b;">
                            <i class="fas fa-book" style="font-size: 48px; opacity: 0.5;"></i>
                            <p style="margin-top: 15px;">Для этой темы нет предустановленных законов</p>
                        </div>
                    `;
                }
            }
            
            // Рендеринг шагов решения
            async renderSteps(text) {
                const container = document.getElementById('steps-container');
                container.innerHTML = '';
                
                const steps = this.extractSteps(text);
                
                if (steps.length === 0) {
                    container.innerHTML = `
                        <div style="text-align: center; padding: 40px; color: #64748b;">
                            <i class="fas fa-list" style="font-size: 48px; opacity: 0.5;"></i>
                            <p style="margin-top: 15px;">Решение не разбито на шаги</p>
                        </div>
                    `;
                    return;
                }
                
                steps.forEach((step, index) => {
                    const stepDiv = document.createElement('div');
                    stepDiv.className = 'formula-card';
                    stepDiv.style.display = 'flex';
                    stepDiv.style.alignItems = 'flex-start';
                    stepDiv.style.gap = '15px';
                    stepDiv.style.marginBottom = '15px';
                    
                    const numberDiv = document.createElement('div');
                    numberDiv.style.cssText = `
                        background: linear-gradient(135deg, #3b82f6, #8b5cf6);
                        color: white;
                        width: 32px;
                        height: 32px;
                        border-radius: 50%;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-weight: 700;
                        flex-shrink: 0;
                    `;
                    numberDiv.textContent = index + 1;
                    
                    const contentDiv = document.createElement('div');
                    contentDiv.style.flex = '1';
                    contentDiv.textContent = step.replace(/^\d+\.\s*/, '').replace(/^[•\-*]\s*/, '');
                    
                    stepDiv.appendChild(numberDiv);
                    stepDiv.appendChild(contentDiv);
                    container.appendChild(stepDiv);
                });
            }
            
            // Обновление статистики
            updateStatistics(data, subjects) {
                document.getElementById('formula-count').textContent = data.formulas?.length || 0;
                document.getElementById('step-count').textContent = this.extractSteps(data.text).length;
                document.getElementById('law-count').textContent = subjects.reduce((count, subject) => {
                    return count + (this.config.laws[subject] ? Object.keys(this.config.laws[subject]).length : 0);
                }, 0);
                document.getElementById('char-count').textContent = data.text.length.toLocaleString();
            }
            
            // Настройка обработчиков событий
            setupEventListeners() {
                // Вкладки
                document.querySelectorAll('.tab').forEach(tab => {
                    tab.addEventListener('click', (e) => {
                        const tabId = e.currentTarget.getAttribute('data-tab');
                        this.switchTab(tabId);
                    });
                });
                
                // Кнопка копирования ссылки
                document.getElementById('copy-link').addEventListener('click', () => {
                    this.copyToClipboard(window.location.href);
                    this.showToast('Ссылка скопирована!');
                });
                
                // Кнопка печати
                document.getElementById('print-btn').addEventListener('click', () => {
                    window.print();
                });
                
                // Кнопка повтора
                document.getElementById('retry-btn').addEventListener('click', () => {
                    location.reload();
                });
            }
            
            // Переключение вкладок
            switchTab(tabId) {
                // Обновляем активную вкладку
                document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
                document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
                
                document.querySelector(`.tab[data-tab="${tabId}"]`).classList.add('active');
                document.getElementById(`${tabId}-tab`).classList.add('active');
            }
            
            // Показать основной контент
            showMainContent() {
                document.getElementById('loading').style.display = 'none';
                document.querySelector('.content-area').style.display = 'grid';
            }
            
            // Показать вкладки
            showTabs() {
                document.getElementById('tabs').style.display = 'flex';
            }
            
            // Показать ошибку
            showError(message) {
                document.getElementById('loading').style.display = 'none';
                document.getElementById('error-message').textContent = message;
                document.getElementById('error-container').style.display = 'block';
            }
            
            // Показать уведомление
            showToast(message) {
                const toast = document.createElement('div');
                toast.style.cssText = `
                    position: fixed;
                    bottom: 20px;
                    right: 20px;
                    background: linear-gradient(135deg, #10b981, #059669);
                    color: white;
                    padding: 15px 25px;
                    border-radius: 8px;
                    box-shadow: 0 5px 20px rgba(0,0,0,0.2);
                    z-index: 10000;
                    animation: slideIn 0.3s ease;
                `;
                toast.textContent = message;
                
                document.body.appendChild(toast);
                
                setTimeout(() => {
                    toast.style.animation = 'slideOut 0.3s ease';
                    setTimeout(() => toast.remove(), 300);
                }, 3000);
                
                // Добавляем стили для анимации
                if (!document.getElementById('toast-styles')) {
                    const style = document.createElement('style');
                    style.id = 'toast-styles';
                    style.textContent = `
                        @keyframes slideIn {
                            from { transform: translateX(100%); opacity: 0; }
                            to { transform: translateX(0); opacity: 1; }
                        }
                        @keyframes slideOut {
                            from { transform: translateX(0); opacity: 1; }
                            to { transform: translateX(100%); opacity: 0; }
                        }
                    `;
                    document.head.appendChild(style);
                }
            }
            
            // Копирование в буфер обмена
            copyToClipboard(text) {
                navigator.clipboard.writeText(text).catch(() => {
                    // Fallback для старых браузеров
                    const textarea = document.createElement('textarea');
                    textarea.value = text;
                    document.body.appendChild(textarea);
                    textarea.select();
                    document.execCommand('copy');
                    document.body.removeChild(textarea);
                });
            }
            
            // Задержка (для асинхронных операций)
            delay(ms) {
                return new Promise(resolve => setTimeout(resolve, ms));
            }
            
            // Логирование производительности
            logPerformance() {
                const perfTime = performance.now() - this.performanceStart;
                console.log(`✅ Ответ загружен за ${perfTime.toFixed(0)}ms для пользователя ${this.userSession}`);
                
                // Можно отправлять метрики на сервер
                if (navigator.sendBeacon) {
                    const metrics = {
                        session: this.userSession,
                        loadTime: perfTime,
                        url: window.location.href,
                        timestamp: Date.now()
                    };
                    
                    navigator.sendBeacon('https://your-analytics.com/metrics', JSON.stringify(metrics));
                }
            }
        }
        
        // ============= ЗАПУСК ПРИ ЗАГРУЗКЕ СТРАНИЦЫ =============
        document.addEventListener('DOMContentLoaded', () => {
            // Проверяем поддержку браузером необходимых функций
            if (!window.btoa || !window.atob) {
                document.getElementById('error-message').textContent = 
                    'Ваш браузер устарел. Пожалуйста, обновите его до последней версии.';
                document.getElementById('loading').style.display = 'none';
                document.getElementById('error-container').style.display = 'block';
                return;
            }
            
            // Запускаем движок
            window.answerEngine = new AnswerEngine();
        });
        
        // ============= ГЛОБАЛЬНЫЕ ФУНКЦИИ ДЛЯ БОТА =============
        // Эти функции можно вызывать извне для управления страницей
        window.AnswerAPI = {
            // Перезагрузить ответ с новыми данными
            reloadWithData: function(data) {
                if (window.answerEngine) {
                    window.answerEngine.currentAnswer = data;
                    window.answerEngine.renderAnswer(data);
                }
            },
            
            // Получить текущие данные ответа
            getCurrentData: function() {
                return window.answerEngine ? window.answerEngine.currentAnswer : null;
            },
            
            // Сгенерировать ссылку для бота
            generateBotLink: function(data) {
                try {
                    const jsonStr = JSON.stringify(data);
                    const base64 = btoa(jsonStr);
                    return `${window.location.origin}${window.location.pathname}?data=${encodeURIComponent(base64)}`;
                } catch {
                    return null;
                }
            },
            
            // Проверить загрузку страницы
            isReady: function() {
                return !!window.answerEngine;
            }
        };
        
        // ============= SERVICE WORKER ДЛЯ ОФФЛАЙН-РЕЖИМА =============
        // Регистрируем Service Worker для кэширования
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').catch(() => {
                    // Игнорируем ошибки - это не критично
                });
            });
        }
    </script>

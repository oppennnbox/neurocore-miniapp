<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🧮 Развёрнутый ответ • Кор</title>
    
    <!-- CDN для быстрой загрузки (кешируются браузерами) -->
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/katex.min.js" crossorigin="anonymous" defer></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/katex.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" crossorigin="anonymous">
    
    <!-- Оптимизированный CSS для 20к+ пользователей -->
    <style>
        /* === ОСНОВНЫЕ СТИЛИ === */
        :root {
            --primary-color: #3b82f6;
            --secondary-color: #8b5cf6;
            --success-color: #10b981;
            --danger-color: #ef4444;
            --warning-color: #f59e0b;
            --dark-color: #1e293b;
            --light-color: #f8fafc;
            --gray-color: #64748b;
            --border-radius: 12px;
            --shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            --transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
        }
        
        body {
            background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
            min-height: 100vh;
            color: var(--dark-color);
            line-height: 1.6;
            padding: 20px;
            overflow-x: hidden;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
            display: grid;
            gap: 20px;
        }
        
        /* === HEADER === */
        .header {
            background: rgba(255, 255, 255, 0.95);
            border-radius: var(--border-radius);
            padding: 25px 30px;
            text-align: center;
            box-shadow: var(--shadow);
            border: 1px solid rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
        }
        
        h1 {
            font-size: clamp(24px, 4vw, 36px);
            font-weight: 800;
            margin-bottom: 15px;
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .user-badge {
            display: inline-block;
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(139, 92, 246, 0.1));
            padding: 8px 20px;
            border-radius: 50px;
            margin: 10px 0;
            font-size: 14px;
            font-weight: 600;
            color: var(--primary-color);
            border: 2px solid rgba(59, 130, 246, 0.2);
        }
        
        /* === CONTENT AREA === */
        .content-area {
            display: grid;
            grid-template-columns: 1fr;
            gap: 20px;
        }
        
        @media (min-width: 992px) {
            .content-area {
                grid-template-columns: 1fr 350px;
            }
        }
        
        /* === MAIN CONTENT === */
        .main-content {
            background: rgba(255, 255, 255, 0.95);
            border-radius: var(--border-radius);
            padding: 30px;
            box-shadow: var(--shadow);
            border: 1px solid rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
        }
        
        .tabs {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 2px solid rgba(0, 0, 0, 0.05);
        }
        
        .tab {
            padding: 12px 24px;
            border-radius: 8px;
            background: rgba(59, 130, 246, 0.08);
            border: 2px solid transparent;
            cursor: pointer;
            font-weight: 600;
            color: var(--gray-color);
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: 8px;
            flex: 1;
            min-width: 120px;
            justify-content: center;
        }
        
        .tab:hover {
            background: rgba(59, 130, 246, 0.15);
            transform: translateY(-2px);
        }
        
        .tab.active {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: white;
            box-shadow: 0 4px 15px rgba(59, 130, 246, 0.3);
        }
        
        .tab-content {
            display: none;
            animation: fadeIn 0.3s ease;
        }
        
        .tab-content.active {
            display: block;
        }
        
        .section-title {
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 3px solid var(--primary-color);
            display: flex;
            align-items: center;
            gap: 12px;
        }
        
        .answer-text {
            font-size: 16px;
            line-height: 1.8;
            color: var(--dark-color);
            white-space: pre-line;
            padding: 20px;
            background: rgba(241, 245, 249, 0.5);
            border-radius: 10px;
            margin-bottom: 25px;
        }
        
        .formula-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }
        
        .formula-card {
            background: white;
            border-radius: 10px;
            padding: 20px;
            border: 2px solid rgba(59, 130, 246, 0.1);
            transition: var(--transition);
        }
        
        .formula-card:hover {
            border-color: var(--primary-color);
            box-shadow: 0 8px 25px rgba(59, 130, 246, 0.15);
            transform: translateY(-3px);
        }
        
        /* === SIDEBAR === */
        .sidebar {
            background: rgba(255, 255, 255, 0.95);
            border-radius: var(--border-radius);
            padding: 25px;
            box-shadow: var(--shadow);
            border: 1px solid rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
            height: fit-content;
            position: sticky;
            top: 20px;
        }
        
        .subject-badges {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 25px;
        }
        
        .subject-badge {
            padding: 10px 18px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .subject-math {
            background: rgba(59, 130, 246, 0.1);
            color: #1d4ed8;
            border: 2px solid rgba(59, 130, 246, 0.2);
        }
        
        .subject-physics {
            background: rgba(16, 185, 129, 0.1);
            color: #059669;
            border: 2px solid rgba(16, 185, 129, 0.2);
        }
        
        .subject-chemistry {
            background: rgba(239, 68, 68, 0.1);
            color: #dc2626;
            border: 2px solid rgba(239, 68, 68, 0.2);
        }
        
        .stats-box {
            background: rgba(241, 245, 249, 0.7);
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
        }
        
        .stat-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
            padding-bottom: 10px;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }
        
        .stat-label {
            color: var(--gray-color);
            font-size: 14px;
        }
        
        .stat-value {
            font-weight: 700;
            color: var(--primary-color);
        }
        
        /* === LOADING === */
        .loading-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 60vh;
            text-align: center;
        }
        
        .spinner {
            width: 60px;
            height: 60px;
            border: 5px solid rgba(59, 130, 246, 0.1);
            border-top: 5px solid var(--primary-color);
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-bottom: 20px;
        }
        
        /* === ERROR === */
        .error-container {
            display: none;
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.1), rgba(220, 38, 38, 0.1));
            border: 2px solid rgba(239, 68, 68, 0.3);
            border-radius: var(--border-radius);
            padding: 30px;
            text-align: center;
            margin-top: 20px;
        }
        
        /* === FOOTER === */
        .footer {
            text-align: center;
            padding: 25px;
            color: var(--gray-color);
            font-size: 14px;
            margin-top: 40px;
            border-top: 1px solid rgba(0, 0, 0, 0.1);
        }
        
        /* === ANIMATIONS === */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        /* === RESPONSIVE === */
        @media (max-width: 768px) {
            .container {
                padding: 10px;
            }
            
            .header, .main-content, .sidebar {
                padding: 20px;
            }
            
            .tabs {
                flex-direction: column;
            }
            
            .tab {
                width: 100%;
                justify-content: center;
            }
            
            .formula-grid {
                grid-template-columns: 1fr;
            }
        }
        
        /* === PERFORMANCE OPTIMIZATIONS === */
        .katex {
            font-size: 1.2em;
            overflow-x: auto;
            overflow-y: hidden;
            padding: 10px;
            background: rgba(255, 255, 255, 0.8);
            border-radius: 8px;
            margin: 5px 0;
        }
        
        .katex-display {
            overflow-x: auto;
            overflow-y: hidden;
            padding: 15px 5px;
        }
        
        /* === SCROLLBAR === */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        
        ::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.05);
            border-radius: 10px;
        }
        
        ::-webkit-scrollbar-thumb {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            border-radius: 10px;
        }
        
        /* === UTILITY === */
        .hidden {
            display: none !important;
        }
        
        .text-center {
            text-align: center;
        }
        
        .mt-20 {
            margin-top: 20px;
        }
        
        .mb-20 {
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Заголовок -->
        <header class="header">
            <h1 id="page-title">🧮 Развёрнутый ответ</h1>
            <div class="user-badge" id="user-badge">
                <i class="fas fa-user"></i> Пользователь #<span id="user-id">0000</span>
            </div>
            <div id="question-preview" class="answer-text" style="display: none; font-style: italic;"></div>
        </header>
        
        <!-- Основная область -->
        <div class="content-area">
            <!-- Главный контент -->
            <main class="main-content">
                <!-- Вкладки -->
                <nav class="tabs" id="tabs" style="display: none;">
                    <div class="tab active" data-tab="explanation">
                        <i class="fas fa-book-open"></i> Объяснение
                    </div>
                    <div class="tab" data-tab="formulas">
